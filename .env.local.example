# Copy to .env.local and fill in real values. .env.local is gitignored - never commit real secrets.

# --- Self-hosted LiveKit server (local dev: from `livekit-server --dev` defaults;
#     once deployed to EKS, use the real signaling URL and the keys from the server config) ---
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# --- Voice pipeline providers (STT / LLM / TTS) ---
# Exact provider set TBD in Phase 1 - placeholders below, trim/replace once chosen.
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=
